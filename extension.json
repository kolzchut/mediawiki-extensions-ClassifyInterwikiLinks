{
	"name": "ClassifyInterwikiLinks",
	"version": "0.2.0",
	"author": [
		"Dror S. [FFS] ([https://www.kolzchut.org.il Kol-Zchut])"
	],
	"url": "https://github.com/kolzchut/mediawiki-extensions-ClassifyInterwikiLinks",
	"descriptionmsg": "classifyinterwikilinks-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.35.0"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\ClassifyInterwikiLinks\\": "src/"
	},
	"HookHandlers": {
		"main": {
			"class": "MediaWiki\\Extension\\ClassifyInterwikiLinks\\Hooks",
			"services": [
				"ConfigFactory",
				"WikiPageFactory"
			]
		}
	},
	"Hooks": {
		"HtmlPageLinkRendererEnd": "main"
	},
	"ConfigRegistry": {
		"ClassifyInterwikiLinks": "GlobalVarConfig::newInstance"
	},
	"config": {
		"ClassifyInterwikiLinksFollowRedirects": {
			"value": true
		}
	},
	"MessagesDirs": {
		"ClassifyInterwikiLinks": [
			"i18n"
		]
	},
	"manifest_version": 2
}
